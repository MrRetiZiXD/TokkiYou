<?xml version="1.0" encoding="utf-8"?>
<!--
  A miniature of the apk the build actually runs on: an application label from
  a string resource, an adaptive icon whose layers are vectors, the same icon
  at two densities, a launcher entry that is an alias rather than an activity,
  and a provider to be sure nothing shifts around it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="cat.narezany.fixture" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34"/>
  <uses-permission android:name="android.permission.INTERNET"/>
  <application
      android:label="@string/app_name"
      android:icon="@mipmap/ic_app"
      android:roundIcon="@mipmap/ic_app"
      android:name="cat.narezany.fixture.App">
    <activity android:name="cat.narezany.fixture.MainActivity" android:exported="false"/>
    <activity-alias
        android:name="cat.narezany.fixture.Splash"
        android:targetActivity="cat.narezany.fixture.MainActivity"
        android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity-alias>
    <provider android:name="cat.narezany.fixture.P"
        android:authorities="cat.narezany.fixture.p" android:exported="false"/>
    <!-- an authority not spelled with the package name: every apk built from
         this one claims it, so two of them cannot be installed at once -->
    <provider android:name="cat.narezany.fixture.Shared"
        android:authorities="com.example.shared.provider1233" android:exported="false"/>
  </application>
</manifest>
